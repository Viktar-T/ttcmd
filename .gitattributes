# Normalise line endings: LF in the repo, native in the working tree.
# Authored on Windows, built on Linux (Vercel) — without this the first
# cross-platform build produces a diff on every file.
* text=auto eol=lf

# Binary assets — never normalise, never diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
